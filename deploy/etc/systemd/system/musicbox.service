[Unit]
Description=MusicBox - web panel and mode lifecycle daemon
After=network.target network-online.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/musicbox serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=musicbox

RuntimeDirectory=musicbox
RuntimeDirectoryMode=0750
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
