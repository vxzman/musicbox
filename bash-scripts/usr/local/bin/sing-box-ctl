#!/bin/bash

set -e

# ---------------- Color Definitions ----------------

# Check if stdout is a terminal (disable colors if piped)
if [ -t 1 ]; then
    C_RED='\033[0;31m'
    C_GREEN='\033[0;32m'
    C_YELLOW='\033[0;33m'
    C_BLUE='\033[0;34m'
    C_CYAN='\033[0;36m'
    C_BOLD='\033[1m'
    C_DIM='\033[2m'
    C_RESET='\033[0m'
else
    C_RED=''
    C_GREEN=''
    C_YELLOW=''
    C_BLUE=''
    C_CYAN=''
    C_BOLD=''
    C_DIM=''
    C_RESET=''
fi

# ---------------- Requirements Check ----------------

if [[ $EUID -ne 0 ]]; then
    echo -e "${C_RED}${C_BOLD}Error:${C_RESET} This script must be run as root!"
    exit 1
fi

MODE="$1"
ACTION="$2"

VALID_MODES="tun tproxy redir-tproxy socks"

# ---------------- Service Mapping ----------------

declare -A MODE_SERVICES=(
    [tun]="sing-box@tun"
    [tproxy]="sing-box@tproxy tproxy@sing-box"
    [redir-tproxy]="sing-box@redir-tproxy redir-tproxy@sing-box"
    [socks]="sing-box@socks"
)

# ---------------- Config Mapping ----------------

declare -A MODE_CONFIGS=(
    [tun]="config_tun.json"
    [tproxy]="config_tproxy.json"
    [redir-tproxy]="config_redir-tproxy.json"
    [socks]="config_socks.json"
)

# ---------------- All Services ----------------

ALL_SERVICES="sing-box@tun sing-box@tproxy tproxy@sing-box sing-box@redir-tproxy redir-tproxy@sing-box sing-box@socks"

# ---------------- Validate Mode ----------------

validate_mode() {
    case "$MODE" in
        tun|tproxy|redir-tproxy|socks) ;;
        *)
            echo -e "${C_RED}${C_BOLD}Error:${C_RESET} Invalid mode '$MODE'"
            echo "Valid modes: $VALID_MODES"
            exit 1
            ;;
    esac
}

# ---------------- Configuration Check ----------------

check_config() {
    if ! command -v sing-box >/dev/null 2>&1; then
        echo -e "${C_RED}${C_BOLD}Error:${C_RESET} sing-box binary not found in PATH!"
        exit 1
    fi

    local config="/etc/sing-box/${MODE_CONFIGS[$MODE]}"

    if [ ! -f "$config" ]; then
        echo -e "${C_RED}${C_BOLD}Error:${C_RESET} config file not found: $config"
        exit 1
    fi
}

# ---------------- Helper: Check if service is alive ----------------

is_service_alive() {
    local svc="$1"
    local state

    state="$(systemctl show -p ActiveState --value "$svc" 2>/dev/null || echo "inactive")"

    case "$state" in
        active|activating|reloading) return 0 ;;
        *) return 1 ;;
    esac
}

# ---------------- Helper: Stop Services ----------------

stop_services() {
    local services="$1"
    local label="${2:-}"

    for svc in $services; do
        if is_service_alive "$svc"; then
            echo -e "  ${C_YELLOW}[STOP]${C_RESET}   ${label:+$label }$svc"
            systemctl stop "$svc" 2>/dev/null || true
        fi
    done
}

# ---------------- TUN Cleanup ----------------

tun_cleanup() {
    local pref
    local table

    # 删除 sing-box TUN 模式添加的策略路由规则
    for pref in 8999 9000 9001 9002 9010; do
        while ip rule del pref "$pref" 2>/dev/null; do
            :
        done
    done

    # 删除 sing-box 及各透明代理模式遗留的 nftables 表
    for table in \
        "inet sing-box" \
        "ip sing-box_tproxy4" \
        "ip sing-box_redir_tproxy4"; do
        # shellcheck disable=SC2086
        nft delete table $table 2>/dev/null || true
    done

    # 清空策略路由表
    for table in 100 2022; do
        ip route flush table "$table" 2>/dev/null || true
    done
}

# ---------------- Stop Mode ----------------

stop_mode() {
    local services="${MODE_SERVICES[$MODE]}"
    local was_alive=false

    for svc in $services; do
        if is_service_alive "$svc"; then
            was_alive=true
            break
        fi
    done

    case "$MODE" in
        tun)
            systemctl stop sing-box@tun 2>/dev/null || true
            sleep 1
            tun_cleanup
            echo -e " ${C_GREEN}[OK]${C_RESET} TUN interceptor stopped."
            ;;

        tproxy)
            systemctl stop tproxy@sing-box 2>/dev/null || true
            systemctl stop sing-box@tproxy 2>/dev/null || true
            echo -e " ${C_GREEN}[OK]${C_RESET} TProxy interceptor stopped."
            ;;

        redir-tproxy)
            systemctl stop redir-tproxy@sing-box 2>/dev/null || true
            systemctl stop sing-box@redir-tproxy 2>/dev/null || true
            echo -e " ${C_GREEN}[OK]${C_RESET} Redir-TProxy interceptor stopped."
            ;;

        socks)
            systemctl stop sing-box@socks 2>/dev/null || true
            echo -e " ${C_GREEN}[OK]${C_RESET} SOCKS interceptor stopped."
            ;;
    esac

    if [ "$was_alive" = false ]; then
        echo -e " ${C_DIM}(Note: $MODE mode was not running)${C_RESET}"
    fi
}

# ---------------- Stop Other Modes ----------------

stop_all_other_modes() {
    local target_mode="$1"
    local target_services="${MODE_SERVICES[$target_mode]}"

    local stopped_any=false
    local tun_was_alive=false

    if [ "$target_mode" != "tun" ]; then
        if is_service_alive "sing-box@tun"; then
            tun_was_alive=true
        fi
    fi

    for svc in $ALL_SERVICES; do
        # Use space-delimited matching to avoid false positives
        # e.g., "tproxy@sing-box" should not match "redir-tproxy@sing-box"
        if echo " $target_services " | grep -q " $svc "; then
            continue
        fi

        if is_service_alive "$svc"; then
            if [ "$stopped_any" = false ]; then
                echo -e " ${C_YELLOW}Stopping other active modes...${C_RESET}"
                stopped_any=true
            fi

            echo -e "  ${C_YELLOW}[STOP]${C_RESET}   $svc"
            systemctl stop "$svc" 2>/dev/null || true
        fi
    done

    if [ "$tun_was_alive" = true ]; then
        sleep 1
        tun_cleanup
    fi
}

# ---------------- Cleanup Partial State ----------------

stop_target_mode_services() {
    local services="${MODE_SERVICES[$MODE]}"
    local any_alive=false

    for svc in $services; do
        if is_service_alive "$svc"; then
            any_alive=true
            break
        fi
    done

    if [ "$any_alive" = true ]; then
        echo -e " ${C_YELLOW}Cleaning up partially running $MODE mode services...${C_RESET}"

        case "$MODE" in
            tproxy|redir-tproxy)

                local reversed=""

                for svc in $services; do
                    reversed="$svc $reversed"
                done

                stop_services "$reversed"
                ;;

            tun)

                stop_services "$services"
                sleep 1
                tun_cleanup
                ;;

            *)

                stop_services "$services"
                ;;
        esac
    fi
}

# ---------------- Start Mode ----------------

start_mode() {
    check_config

    stop_target_mode_services

    stop_all_other_modes "$MODE"

    case "$MODE" in

        tun)

            echo -e " ${C_CYAN}Starting TUN Interceptor...${C_RESET}"

            systemctl start sing-box@tun

            echo -e " ${C_GREEN}[OK]${C_RESET} TUN interceptor started."
            ;;

        tproxy)

            echo -e " ${C_CYAN}Starting TProxy Interceptor...${C_RESET}"

            systemctl start sing-box@tproxy

            sleep 1

            systemctl start tproxy@sing-box

            if is_service_alive "sing-box@tproxy" && is_service_alive "tproxy@sing-box"; then
                echo -e " ${C_GREEN}[OK]${C_RESET} TProxy interceptor started."
            else
                echo -e " ${C_YELLOW}[WARN]${C_RESET} TProxy may not have started correctly."
                echo "        Check: sing-box-ctl tproxy status"
            fi
            ;;

        redir-tproxy)

            echo -e " ${C_CYAN}Starting Redir-TProxy Interceptor...${C_RESET}"

            systemctl start sing-box@redir-tproxy

            sleep 1

            systemctl start redir-tproxy@sing-box

            if is_service_alive "sing-box@redir-tproxy" && is_service_alive "redir-tproxy@sing-box"; then
                echo -e " ${C_GREEN}[OK]${C_RESET} Redir-TProxy interceptor started."
            else
                echo -e " ${C_YELLOW}[WARN]${C_RESET} Redir-TProxy may not have started correctly."
                echo "        Check: sing-box-ctl redir-tproxy status"
            fi
            ;;

        socks)

            echo -e " ${C_CYAN}Starting SOCKS Interceptor...${C_RESET}"

            systemctl start sing-box@socks

            echo -e " ${C_GREEN}[OK]${C_RESET} SOCKS interceptor started."
            ;;
    esac
}

# ---------------- Get Mode State ----------------

get_mode_state() {
    local mode="$1"
    local services="${MODE_SERVICES[$mode]}"

    local total=0
    local alive=0

    for svc in $services; do
        total=$((total + 1))

        if is_service_alive "$svc"; then
            alive=$((alive + 1))
        fi
    done

    if [ "$alive" -eq "$total" ]; then
        echo "active"
    elif [ "$alive" -gt 0 ]; then
        echo "partial"
    else
        echo "inactive"
    fi
}

# ---------------- JSON Status ----------------

status_json() {
    local active_mode=""
    local json='{"modes":{'
    local first=true

    for mode in tun tproxy redir-tproxy socks; do
        local state
        state="$(get_mode_state "$mode")"

        if [ "$first" = true ]; then
            first=false
        else
            json="${json},"
        fi

        json="${json}\"${mode}\":{\"status\":\"${state}\"}"

        if [ "$state" = "active" ] && [ -z "$active_mode" ]; then
            active_mode="$mode"
        fi
    done

    if [ -n "$active_mode" ]; then
        json="${json}},\"activeMode\":\"${active_mode}\"}"
    else
        json="${json}},\"activeMode\":null}"
    fi

    echo "$json"
}

# ---------------- Status ----------------

status_mode() {

    if [ "${3:-}" = "--json" ] || [ "${3:-}" = "-j" ]; then
        status_json
        return
    fi

    echo -e " ${C_BOLD}Sing-Box Interception Status:${C_RESET}"
    echo -e " ${C_DIM}─────────────────────────────────${C_RESET}"

    for mode in tun tproxy redir-tproxy socks; do
        state="$(get_mode_state "$mode")"

        case "$state" in
            active)
                echo -e "  ${C_GREEN}[ACTIVE]${C_RESET}   ${C_BOLD}$mode${C_RESET} mode"
                ;;
            partial)
                echo -e "  ${C_YELLOW}[PARTIAL]${C_RESET}  ${C_BOLD}$mode${C_RESET} mode"
                ;;
            inactive)
                echo -e "  ${C_DIM}[INACTIVE]${C_RESET} ${C_DIM}$mode mode${C_RESET}"
                ;;
        esac
    done

    echo ""
    echo -e " ${C_BOLD}Service Details:${C_RESET}"

    for svc in $ALL_SERVICES; do
        local state

        state="$(systemctl show -p ActiveState --value "$svc" 2>/dev/null || echo "inactive")"

        case "$state" in
            active)
                echo -e "    ${C_GREEN}[ACTIVE]${C_RESET}      $svc"
                ;;
            activating)
                echo -e "    ${C_CYAN}[ACTIVATING]${C_RESET}  $svc"
                ;;
            failed)
                echo -e "    ${C_RED}[FAILED]${C_RESET}      $svc"
                ;;
            *)
                echo -e "    ${C_DIM}[INACTIVE]${C_RESET}    $svc"
                ;;
        esac
    done
}

# ---------------- Logs ----------------

show_logs() {
    local count="${3:-50}"

    case "$MODE" in
        tun)
            journalctl -u sing-box@tun --no-pager -n "$count"
            ;;

        tproxy)
            journalctl -u sing-box@tproxy -u tproxy@sing-box --no-pager -n "$count"
            ;;

        redir-tproxy)
            journalctl -u sing-box@redir-tproxy -u redir-tproxy@sing-box --no-pager -n "$count"
            ;;

        socks)
            journalctl -u sing-box@socks --no-pager -n "$count"
            ;;
    esac
}

# ---------------- Main ----------------

if [ "${1:-}" = "--json" ] || [ "${1:-}" = "-j" ]; then
    status_json
    exit 0
fi

if [ -z "$MODE" ] || [ -z "$ACTION" ]; then
    echo "Usage:"
    echo "  $0 {tun|tproxy|redir-tproxy|socks} {start|stop|restart|status|log [lines]}"
    echo "  $0 --json"
    echo ""
    echo "Available modes:"
    echo "  tun"
    echo "  tproxy"
    echo "  redir-tproxy"
    echo "  socks"
    exit 1
fi

validate_mode

case "$ACTION" in

    start)
        start_mode
        ;;

    stop)
        stop_mode
        ;;

    restart)
        stop_mode
        start_mode
        ;;

    status)
        status_mode "$@"
        ;;

    log)
        show_logs "$@"
        ;;

    *)

        echo -e "${C_RED}${C_BOLD}Error:${C_RESET} Invalid action '$ACTION'"

        echo "Valid actions:"
        echo "  start"
        echo "  stop"
        echo "  restart"
        echo "  status"
        echo "  log"

        exit 1
        ;;
esac
