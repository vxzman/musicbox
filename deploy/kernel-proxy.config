# MusicBox / sing-box 代理服务器、VPN、透明代理常用内核选项。
# 可与自定义 .config 用 scripts/kconfig/merge_config.sh 合并。
# 标了 [必须] 的是当前 MusicBox 模式会直接踩到的；其余为通用代理机建议项。
#
# 缺 CONFIG_NFT_REDIR 时，redir-tproxy 的
#   nft ... redirect to :22025
# 会报: Could not process rule: No such file or directory

# ── 基础转发 / 策略路由 [必须] ──────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_FIB_RULES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IP_ROUTE_MULTIPATH=y

# ── TUN / 虚拟网卡：tun 模式、auto_route [必须] ─────────────
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_NETDEVICES=y

# ── Netfilter 核心 [必须] ───────────────────────────────────
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_HASH=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y

# ── redir-tproxy：TCP REDIRECT [必须，缺了就是这次的报错] ──
CONFIG_NFT_REDIR=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y

# ── tproxy / redir-tproxy UDP [必须] ────────────────────────
CONFIG_NFT_TPROXY=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NFT_SOCKET=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y

# ── 透明代理套接字：IP_TRANSPARENT / SO_ORIGINAL_DST [必须] ─
# 随 NETFILTER + TPROXY 带上；确认不要关 IP_TRANSPARENT 相关过滤。
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# ── iptables 兼容（部分工具/旧脚本） ────────────────────────
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# ── 本机发出流量按 GID 放行（meta skgid） ───────────────────
CONFIG_CGROUPS=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y

# ── VPN / 隧道（EP、自建入站常见） ──────────────────────────
CONFIG_WIREGUARD=y
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_IPV6_TUNNEL=y
CONFIG_IPV6_SIT=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_PPP=y
CONFIG_PPPOE=y

# ── eBPF 入站（MusicBox ebpf 模式 / 测试版 sing-box） ───────
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_XDP_SOCKETS=y
CONFIG_DEBUG_INFO_BTF=y

# ── TCP 性能（代理机常见） ──────────────────────────────────
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_FASTOPEN=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# ── 连接跟踪容量 / 助手（可选） ─────────────────────────────
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_NAT_FTP=y
CONFIG_IP_SET=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
