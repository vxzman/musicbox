# ─── 构建产物 ───────────────────────────────
/musicbox
/singbox-manager
/build/
*.tar.gz
deploy/usr/local/bin/*
!deploy/usr/local/bin/.gitkeep

# ─── 前端 ───────────────────────────────────
web/node_modules/
# dist 是构建产物；仅保留占位 index.html 使未构建前端时 go build 也能通过
web/dist/*
!web/dist/index.html

# ─── 旧版 bash 参考实现（不随发布提供）───────
bash/
bash-scripts/

# ─── 内部文档（不随发布提供）─────────────────
PLAN.md

# ─── 编辑器 / 系统 / 杂项 ───────────────────
.claude/
.idea/
.vscode/
.DS_Store
*.log
*.swp
*.sock
grok.txt
# 根目录遗留的空 package-lock（前端锁文件在 web/ 内，正常入库）
/package-lock.json
